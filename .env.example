# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/salas?sslmode=require

# API
PORT=4000
SESSION_SECRET=dev-session-secret-min-16
INTERNAL_API_SECRET=dev-internal-secret-16
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:4000

# Cifrado tokens MP (opcional; si falta usa SESSION_SECRET)
TOKEN_ENCRYPTION_KEY=

# Mercado Pago
# MP_MOCK=true → preferencias locales + /public/pagos/mock-pay (default en dev)
MP_MOCK=true
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# OAuth app (conectar cuenta del estudio — como Wally)
# Redirect URI a registrar en MP: http://127.0.0.1:4000/mp/oauth/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# MP_OAUTH_REDIRECT_URI=http://127.0.0.1:4000/mp/oauth/callback
# Comisión % SalaYa sobre señas (Checkout Pro marketplace_fee). Ej: 5
MP_MARKETPLACE_FEE_PERCENT=0

# Next / Auth.js
AUTH_SECRET=dev-auth-secret-change-me-32chars
AUTH_URL=http://localhost:3000
# Google OAuth (https://console.cloud.google.com/)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Uploads locales (Multer + Sharp → WebP). Default: apps/api/uploads
# UPLOADS_DIR=

# Google Maps (mapa directorio + autocomplete de dirección en panel)
# Habilitar: Maps JavaScript API + Places API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email (Resend — mismo patrón que Wally)
# EMAIL_MOCK=true → no llama a Resend (default en dev sin API key)
EMAIL_MOCK=true
EMAIL_FROM=SalaYa <noreply@salaya.local>
# Alias Wally-compatible (si está, pisa EMAIL_FROM):
# RESEND_FROM=SalaYa <noreply@tudominio.com>
# RESEND_API_KEY=re_...
# RESEND_REPLY_TO=soporte@tudominio.com
# Worker: ms entre ticks (0 = solo POST /internal/jobs/notifications/tick)
# NOTIFICATIONS_POLL_MS=15000
